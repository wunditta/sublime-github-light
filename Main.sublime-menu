[
    {
        "id": "tools",
        "children": [
            {
                "caption": "GitHub Light",
                "id": "github-light",
                "children": [
                    { "caption": "Diff Unsaved Changes…", "command": "ghl_diff_unsaved" },
                    { "caption": "Show Project Changes…", "command": "ghl_status" },
                    { "caption": "File Review", "id": "github-light-main-review",
                      "children": [
                            { "caption": "Diff GitHub and Local in Sublime", "command": "ghl_diff" },
                            { "caption": "View on GitHub", "command": "ghl_open_online", "args": {"kind": "blob"} },
                            { "caption": "Blame on GitHub", "command": "ghl_open_online", "args": {"kind": "blame"} },
                            { "caption": "History on GitHub", "command": "ghl_open_online", "args": {"kind": "history"} },
                        ]
                    },
                    { "caption": "-" },
                    { "caption": "Sync", "command": "ghl_sync" },
                    { "caption": "Download", "command": "ghl_download" },
                    { "caption": "Commit Current File", "command": "ghl_commit", "args": {"scope": "current"} },
                    { "caption": "Commit All", "command": "ghl_commit", "args": {"scope": "all"} },
                    { "caption": "-" },
                    { "caption": "Create Release…", "command": "ghl_release" },
                    { "caption": "Move Tag…", "command": "ghl_move_tag" },
                    { "caption": "-" },
                    { "caption": "New Project…", "command": "ghl_new_project" },
                    { "caption": "Settings", "command": "ghl_settings" }
                ]
            }
        ]
    },
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "GitHub Light",
                        "children": [
                            { "caption": "Settings", "command": "ghl_settings" },
                            {
                                "caption": "Key Bindings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/GitHub Light/Default.sublime-keymap",
                                    "user_file": "${packages}/User/Default (${platform}).sublime-keymap",
                                    "default": "[\n\t$0\n]\n"
                                }
                            },
                            { "caption": "-" },
                            {
                                "caption": "README",
                                "command": "open_file",
                                "args": { "file": "${packages}/GitHub Light/README.md" }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
