{
    // General settings for all GitHub Light projects.
    // Every setting here can be overridden per project in the .sublime-project file:
    //   "settings": { "github_light": { "repository": "owner/name", "folder": "github" } }
    // Open it with Project > Edit Project. The token belongs here (User settings), never in a project file.

    // The repository the folder is synced with, as "owner/name".
    "repository": "",

    // The branch.
    "branch": "main",

    // Local folder holding the working copy of the repository. A relative path is taken from the folder holding
    // the project file (without a project file: from the first folder in the side bar).
    "folder": "github",

    // Local folder names that stand for a differently named folder on GitHub (first path segment only).
    // Default: the local folder "dot-github" is committed as ".github" and ".github" is downloaded into "dot-github".
    "folder_map": {"dot-github": ".github"},

    // Files never downloaded or committed (glob patterns, matched against the full relative path and the file name).
    "ignore": [".github-sync-hash.json", "*.sublime-workspace", "*.sublime-project", ".DS_Store", "Thumbs.db"],

    // Fine-grained personal access token (GitHub > Settings > Developer settings > Personal access tokens),
    // limited to the repository, with the permission "Contents: Read and write". Put it into the User settings file.
    "token": "",

    // Show the list of files and ask before a commit.
    "confirm_commit": true,

    // Ask for the commit message. false: the default message is used ("Add x.md", "Update x.md", "Add 2 files, update 3 files").
    "ask_commit_message": true,

    // Ask for title and notes when creating a release. false: the title is the tag, the notes stay empty.
    "ask_release_details": true,

    // Prefix of the version tags Create Release makes and reads ("v" -> v1.2.3, "" -> 1.2.3).
    "tag_prefix": "v",

    // Moving tag after Create Release (a tag like v1 that always points to the latest 1.x release; GitHub Actions
    // are referenced that way: uses: owner/action@v1).
    //   "ask":   ask after each release whether to move the major (v1) or minor (v1.2) tag
    //   "major": move the major tag (v1) without asking
    //   "minor": move the minor tag (v1.2) without asking
    //   "":      never
    //   any other text: a fixed tag name that is moved to every release (e.g. "latest")
    "moving_tag": "",

    // Create Release takes the release notes from the "Unreleased" section of CHANGELOG.md in the folder (Keep a Changelog
    // format: "## [Unreleased]", "## [v1.2.3] - 2026-01-31" - the heading carries the tag name). The section is renamed to the new version with today's date,
    // a new empty Unreleased section is added, and the file is committed before the release is created. The notes are
    // then not asked for (ask_release_details only asks the title). An empty Unreleased section stops the release.
    "release_notes_from_changelog": false,

    // With release_notes_from_changelog: also write messages/<tag>.txt with the same notes and its entry in
    // messages.json - the note Package Control shows to users of a Sublime Text package after the upgrade.
    "sublime_version_files_from_changelog": false,

    // Show the output panel when GitHub Light reports something.
    "show_panel_on_output": true,
}
