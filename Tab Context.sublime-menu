[
    { "caption": "-", "id": "github-light-tab" },
    { "caption": "Diff Unsaved Changes…", "command": "ghl_diff_unsaved", "args": {"context": true} },
    { "caption": "Revert File", "command": "ghl_revert_file", "args": {"context": true} },
    { "caption": "Show GitHub Sync Status…", "command": "ghl_status", "args": {"context": true} },
    { "caption": "File Review on GitHub", "id": "github-light-tab-review",
      "children": [
            { "caption": "Diff GitHub and Local in Sublime", "command": "ghl_diff", "args": {"context": true} },
            { "caption": "View on GitHub", "command": "ghl_open_online", "args": {"kind": "blob", "context": true} },
            { "caption": "Blame on GitHub", "command": "ghl_open_online", "args": {"kind": "blame", "context": true} },
            { "caption": "History on GitHub", "command": "ghl_open_online", "args": {"kind": "history", "context": true} }
        ]
    },
    { "caption": "-" },
    { "caption": "Commit File to GitHub", "command": "ghl_commit", "args": {"scope": "current", "context": true} },
]
